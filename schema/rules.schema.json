{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/y-yaoyyy/contribution-ledger/schema/rules.schema.json",
  "title": "ContributionLedger custom rules",
  "description": "A JSON array of rules, or an object with a rules array.",
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    {
      "type": "object",
      "required": ["rules"],
      "properties": { "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } } },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "component", "symptom", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._-]+$" },
        "component": { "type": "string", "minLength": 1 },
        "symptom": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "all": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "any": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "none": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["all"], "properties": { "all": { "minItems": 1 } } },
        { "required": ["any"], "properties": { "any": { "minItems": 1 } } }
      ]
    }
  }
}