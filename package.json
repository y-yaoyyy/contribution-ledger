{
  "name": "contributionledger",
  "version": "0.2.0",
  "description": "Offline evidence ledger that turns engineering session summaries into reviewable OSS contribution cases.",
  "type": "module",
  "bin": {
    "contributionledger": "bin/contributionledger.mjs"
  },
  "exports": {
    ".": "./src/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "demo",
    "schema",
    "scripts",
    "README*.md",
    "LICENSE"
  ],
  "scripts": {
