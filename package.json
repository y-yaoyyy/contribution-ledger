    "check": "node scripts/check.mjs",
    "demo": "node bin/contributionledger.mjs --demo"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y-yaoyyy/contribution-ledger.git"
  },
  "homepage": "https://github.com/y-yaoyyy/contribution-ledger#readme",
  "bugs": {
    "url": "https://github.com/y-yaoyyy/contribution-ledger/issues"
  },
  "keywords": [
    "session",
